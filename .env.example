# ============================================
# Database — Supabase PostgreSQL
# Get this from: Supabase → Project Settings → Database → Connection string → URI
# IMPORTANT: Replace [YOUR-PASSWORD] with your Supabase database password
# ============================================
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# ============================================
# Auth — JWT Settings
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
# ============================================
SECRET_KEY=your-long-random-secret-key-minimum-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# Groq AI — Get key from console.groq.com
# ============================================
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================
# CORS — comma-separated list of allowed frontend origins
# Add your Vercel URL here after deployment
# ============================================
ALLOWED_ORIGINS=https://your-app.vercel.app,https://yourdomain.com,https://www.yourdomain.com
